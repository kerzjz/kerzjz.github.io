---
import Layout from '../layouts/Layout.astro';
import Playlist from '../components/Playlist.svelte';
import { musicConfig } from '../config/site';
---

<Layout
  title={musicConfig.title}
  description={musicConfig.description}
>
  <div class="w-full max-w-3xl mx-auto">
    <div class="bg-white dark:bg-slate-800 border-4 border-[#0284c7] p-6 md:p-10 shadow-[6px_6px_0px_0px_#0284c7] rounded-sm animate-card-entrance opacity-0">
      <div class="flex items-center gap-3 mb-6 border-b-2 border-dashed border-[#0284c7]/20 pb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-[2.5] text-[#0284c7]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        <h1 class="text-xl md:text-2xl font-black text-[#0284c7]">
          {musicConfig.sectionTitle}
        </h1>
        <span class="text-xs font-bold text-slate-400 font-mono">({musicConfig.playlist.length} 首)</span>
      </div>

      <Playlist client:load />
    </div>
  </div>
</Layout>
